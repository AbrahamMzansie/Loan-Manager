datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String // bcrypt hash
  role      String   @default("staff") // "admin" | "staff"
  defaultRate       Float? // personal default interest rate; falls back to org-wide Settings if unset
  defaultPeriodDays Int?   // personal default period length; falls back to org-wide Settings if unset
  // Per-lender company profile shown on invoices this user creates (a
  // separate side business's identity, e.g. Owen Transport Services) -
  // distinct from the lending business's Settings.businessName.
  invoiceCompanyName       String?
  invoiceLogo              String? // base64 data URL
  invoiceBankAccountHolder String?
  invoiceBankAccountNumber String?
  invoiceBankName          String?
  invoiceBranchCode        String?
  createdAt DateTime @default(now())
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  idNumber  String?
  notes     String?
  createdBy Int?
  createdAt DateTime @default(now())
  loans     Loan[]
  invoices  Invoice[]
}

model Loan {
  id           Int       @id @default(autoincrement())
  customer     Customer  @relation(fields: [customerId], references: [id])
  customerId   Int
  principal    Float
  interestRate Float     @default(0.30) // e.g. 0.30 = 30% per period
  periodDays   Int       @default(30) // length of one interest period, in days
  startDate    DateTime  @default(now())
  status       String    @default("active") // "active" | "paid" | "written_off"
  notes        String?
  shareToken   String?   @unique // set on first "send invoice"; lets the public invoice link work without login
  createdBy    Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payments     Payment[]

  @@index([customerId])
  @@index([status])
}

model Payment {
  id         Int      @id @default(autoincrement())
  loan       Loan     @relation(fields: [loanId], references: [id])
  loanId     Int
  amount     Float
  date       DateTime @default(now())
  method     String? // "cash" | "eft" | "other"
  note       String?
  recordedBy Int?
  createdAt  DateTime @default(now())

  @@index([loanId])
}

// Single-row table holding org-wide defaults, editable by admins from the Settings page.
model Settings {
  id                Int    @id @default(1)
  businessName      String @default("My Lending Business")
  defaultRate       Float  @default(0.30)
  defaultPeriodDays Int    @default(30)
}

// A simple itemized invoice for a side business (unrelated to loan
// interest/balances) - e.g. transport trips billed to the same customer.
model Invoice {
  id         Int           @id @default(autoincrement())
  customer   Customer      @relation(fields: [customerId], references: [id])
  customerId Int
  date       DateTime      @default(now())
  notes      String?
  shareToken String?       @unique
  createdBy  Int?
  createdAt  DateTime      @default(now())
  items      InvoiceItem[]

  @@index([customerId])
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   Int
  description String
  amount      Float

  @@index([invoiceId])
}
