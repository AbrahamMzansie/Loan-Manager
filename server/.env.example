# PostgreSQL connection string. Example for local docker-compose setup:
DATABASE_URL="postgresql://loanmanager:loanmanager@localhost:5432/loanmanager?schema=public"

# Change this to a long random string in production
JWT_SECRET="replace-this-with-a-long-random-secret"

# Port the API server listens on
PORT=4000

# Comma-separated list of origins allowed to call the API (your frontend URL)
CORS_ORIGIN="http://localhost:5173"

# Set to true to allow the very first admin account to self-register via
# POST /api/auth/register-first-admin. Should be turned off (false) after
# you've created your admin account.
ALLOW_FIRST_ADMIN_SETUP=true
